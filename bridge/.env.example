# URL del backend de TrepAI (local o Vercel)
TREPAI_URL=http://127.0.0.1:8000

# Debe ser EXACTAMENTE el mismo valor que PUENTE_TOKEN en el .env del backend
PUENTE_TOKEN=cambia-esta-clave-por-una-aleatoria

# Filtros: el bot SOLO responde si se cumple alguno (así no le contesta a
# todos tus contactos). Debes definir al menos uno.
#
# Números permitidos, solo dígitos con código país, separados por coma
NUMEROS_PERMITIDOS=56967158624
#
# Palabra clave: si un número NO está en la lista, igual puede activar el
# bot empezando su mensaje con esta palabra (ej. "barberia hola").
# El chat queda activo 30 minutos desde su último mensaje.
PALABRA_CLAVE=hola
