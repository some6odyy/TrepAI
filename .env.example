# --- Base de datos ---
# Desarrollo local: SQLite (no requiere nada más)
DATABASE_URL=sqlite:///./trepai.db

# Producción en Vercel: Postgres real (SQLite no sirve en serverless,
# el disco no persiste entre invocaciones). Ejemplo con Neon:
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[clave]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# Cifra en reposo el token de WhatsApp de cada negocio. Generar la propia
# con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=6Tx_gPZKphFL3YldOKPEOnYR78mPEoLSzFZed6FzhBg=

# El numero de WhatsApp de cada negocio se conecta desde el Dashboard
# (PUT /negocio/{id}/whatsapp), no aqui.
WHATSAPP_VERIFY_TOKEN=trepai_verify

# --- Puente de demo con whatsapp-web.js (carpeta bridge/) ---
# Deja PUENTE_TOKEN vacío para desactivarlo (recomendado en Vercel).
# Para usarlo, pon cualquier string largo y el MISMO en bridge/.env
PUENTE_TOKEN=
# Negocio que atiende el puente; vacío = el primer negocio con el bot encendido
PUENTE_ID_NEGOCIO=

AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-5.4-mini

# En producción, reemplazar "*" por el dominio real del Dashboard
# (ej. https://trepai.vercel.app) una vez desplegado.
CORS_ALLOWED_ORIGINS=*
